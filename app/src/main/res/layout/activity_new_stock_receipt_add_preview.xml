<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:ignore="MissingDefaultResource">

    <TextView
        android:layout_width="wrap_content"
        android:text="Products (0)"
        android:layout_gravity="left"
        android:gravity="left"
        android:layout_marginTop="5dp"
        android:layout_marginLeft="5dp"
        android:id="@+id/count_receipt_prev"
        android:padding="6dp"
        android:textStyle="bold"
        android:textColor="@color/pink_clr1"
        android:textSize="12sp"
        android:layout_height="wrap_content"/>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:orientation="vertical"
                                android:background="#f2f2f2"
                                android:id="@+id/product_summaryLay"
                                android:layout_height="match_parent">

                                <include
                                    android:id="@+id/title_layout"
                                    layout="@layout/good_receipt_preview_title"/>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:text="No Product Added !"
                                    android:layout_gravity="center"
                                    android:gravity="center"
                                    android:layout_marginTop="100dp"
                                    android:id="@+id/empty_textPre"
                                    android:padding="10dp"
                                    android:textStyle="bold"
                                    android:textSize="12sp"
                                    android:layout_height="wrap_content"/>


                                <androidx.recyclerview.widget.RecyclerView
                                    android:id="@+id/rv_pdtSummaryList"
                                    android:layout_width="match_parent"
                                    android:visibility="gone"
                                    android:paddingBottom="60dp"
                                    android:nestedScrollingEnabled="true"
                                    android:layout_height="wrap_content"
                                    tools:listitem="@layout/good_receipt_preview_items" />
                            </LinearLayout>
</LinearLayout>