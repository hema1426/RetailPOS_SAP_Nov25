<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_width="match_parent"
        android:id="@+id/rootLayout"
        android:background="#f5f5f5"
        android:orientation="vertical"
        android:layout_height="match_parent">

        <!-- Define the progress bar layout  -->
        <include
            android:id="@+id/progress_layout"
            android:visibility="gone"
            layout="@layout/progress_bar"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:orientation="vertical"
            android:layout_gravity="center"
            android:visibility="gone"
            android:id="@+id/empty_layoutadj"
            android:gravity="center"
            android:layout_height="match_parent">



            <ImageView
                android:layout_width="300dp"
                android:src="@drawable/no_invoice"
                android:layout_height="300dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:text="No Stock Found !"
                android:textColor="#212121"
                android:textSize="18sp"
                android:layout_height="35dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:text="Add the first one to your list"
                android:layout_marginTop="10dp"
                android:textSize="16sp"
                android:layout_height="35dp"/>

            <Button
                android:layout_width="300dp"
                android:text="+ Create Sales Order"
                android:layout_marginTop="100dp"
                android:id="@+id/create_sales"
                android:visibility="gone"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="@color/white"
                android:background="@drawable/button_order"
                android:layout_height="wrap_content"/>

        </LinearLayout>

        <!-- visible the Recyclerview when all content loaded -->

        <LinearLayout
            android:layout_width="match_parent"
            android:orientation="vertical"
            android:layout_height="match_parent">

            <!-- Top Sliding Banners -->

            <LinearLayout
                android:layout_width="match_parent"
                android:orientation="vertical"
                android:layout_height="match_parent">


                <FrameLayout
                    android:layout_width="match_parent"
                    android:paddingTop="10dp"
                    android:orientation="vertical"
                    android:layout_height="match_parent">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/stockAdjustList"
                        android:layout_width="match_parent"
                        android:layout_height="831dp"
                        android:paddingBottom="40dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:listitem="@layout/stock_adjust_item" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_gravity="bottom|center"
                        android:background="#006DDB"
                        android:gravity="end"
                        android:visibility="gone"
                        android:id="@+id/outstanding_layout"
                        android:padding="10dp"
                        android:orientation="horizontal"
                        android:layout_height="40dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:text="Total :"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/white"
                            android:layout_height="wrap_content"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:paddingRight="20sp"
                            android:id="@+id/net_totalAdjust"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/white"
                            android:layout_height="wrap_content"/>

                    </LinearLayout>

                </FrameLayout>
            </LinearLayout>

        </LinearLayout>

        <include
            android:id="@+id/search_filteradjust"
            android:visibility="gone"
            layout="@layout/stockadjust_filter_layout"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:background="#8000"
            android:visibility="gone"
            android:id="@+id/trans_layoutAdjust"
            android:layout_height="match_parent"
            android:orientation="horizontal" />

    </FrameLayout>

    <RelativeLayout
        android:id="@+id/design_bottom_sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:paddingBottom="@dimen/activity_vertical_margin"
        android:paddingLeft="@dimen/activity_horizontal_margin"
        android:paddingRight="@dimen/activity_horizontal_margin"
        android:paddingTop="@dimen/activity_vertical_margin"
        app:behavior_hideable="true"
        app:behavior_peekHeight="0dp"
        app:elevation="4dp"
        app:layout_behavior="@string/bottom_sheet_behavior">

        <include
            android:id="@+id/sales_option"
            android:visibility="gone"
            layout="@layout/stock_adjust_option"/>


    </RelativeLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>