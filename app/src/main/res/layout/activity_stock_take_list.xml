<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
>
    <FrameLayout
        android:layout_width="match_parent"
        android:id="@+id/rootLayout"
        android:background="#f5f5f5"
        android:orientation="vertical"
        android:layout_height="match_parent">



    <LinearLayout
        android:layout_width="match_parent"
        android:orientation="horizontal"
        android:padding="10dp"
        android:layout_height="wrap_content">

        <EditText
            android:layout_width="match_parent"
            android:background="@drawable/search_background"
            android:textSize="14sp"
            android:id="@+id/search_take_ed"
            android:layout_weight="1"
            android:visibility="gone"
            android:hint="Search Stock Take "
            android:drawableRight="@drawable/ic_baseline_search_24"
            android:padding="10dp"
            android:layout_height="40dp"/>

        <View
            android:layout_width="5dp"
            android:layout_height="match_parent"/>

        <Button
            android:layout_width="wrap_content"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:visibility="gone"
            android:textSize="12sp"
            android:id="@+id/add_transfer"
            android:background="@drawable/button_order"
            android:text="Add +"
            android:layout_height="35dp"/>

    </LinearLayout>



    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/stockTakeList"
        tools:listitem="@layout/stock_take_list_item"
        android:layout_width="match_parent"
        android:paddingBottom="40dp"
        android:visibility="gone"
        android:background="@color/lit_grey_new"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <TextView
        android:layout_width="match_parent"
        android:gravity="center"
        android:visibility="visible"
        android:id="@+id/empty_text_take"
        android:textStyle="bold"
        android:text="No Record Found....!"
        android:layout_gravity="center"
        android:layout_height="match_parent"/>
        <include
            android:id="@+id/search_filtertake"
            android:visibility="gone"
            layout="@layout/stockadjust_filter_layout"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:background="#8000"
        android:visibility="gone"
        android:id="@+id/trans_layouttake"
        android:layout_height="match_parent"
        android:orientation="horizontal" />


    </FrameLayout>

</LinearLayout>