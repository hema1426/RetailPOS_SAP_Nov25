<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/lit_grey_new"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
 >
    <include
        android:id="@+id/search_filter_trans_draft"
        android:visibility="gone"
        layout="@layout/trans_draft_filter_layout"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:orientation="horizontal"
        android:visibility="gone"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="wrap_content"
            android:text="From Date"
            android:textStyle="bold"
            android:layout_marginLeft="10dp"
            android:textSize="12sp"
            android:textColor="@color/black"
            android:layout_height="wrap_content"/>

        <TextView
            android:layout_width="wrap_content"
            android:textStyle="bold"
            android:layout_marginLeft="10dp"
            android:drawablePadding="10dp"
            android:id="@+id/from_date"
            android:textSize="12sp"
            android:textColor="@color/colorPrimary"
            android:layout_height="wrap_content"/>


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="40dp"
            android:text="To Date:"
            android:textColor="@color/black"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:textStyle="bold"
            android:id="@+id/to_date"
            android:drawablePadding="10dp"
            android:layout_marginRight="10dp"
            android:layout_marginLeft="10dp"
            android:textSize="12sp"
            android:textColor="@color/colorPrimary"
            android:layout_height="wrap_content"/>

        <Button
            android:layout_width="30dp"
            android:layout_marginRight="20dp"
            android:id="@+id/search"
            android:textColor="@color/white"
            android:padding="@dimen/_3sdp"
            android:background="@drawable/button_order"
            android:layout_height="30dp"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:orientation="horizontal"
        android:padding="10dp"
        android:visibility="gone"
        android:layout_height="wrap_content">

        <EditText
            android:layout_width="match_parent"
            android:background="@drawable/search_background"
            android:textSize="14sp"
            android:id="@+id/transfer_search"
            android:layout_weight="1"
            android:hint="Search Stock Request"
            android:drawableRight="@drawable/ic_baseline_search_24"
            android:padding="10dp"
            android:layout_height="40dp"/>

        <View
            android:layout_width="5dp"
            android:layout_height="match_parent"/>

        <Button
            android:layout_width="wrap_content"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="12sp"
            android:id="@+id/add_transfer"
            android:background="@drawable/button_order"
            android:text="Add +"
            android:layout_height="35dp"/>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dip"/>

    <include
        layout="@layout/request_title"
        android:visibility="gone"
       />
    <View
        android:layout_width="match_parent"
        android:layout_height="2dip"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:orientation="horizontal"
        android:padding="5dp"
        android:layout_height="wrap_content">
        <TextView
            android:layout_width="match_parent"
            android:gravity="left"
            android:id="@+id/stockreq_size"
            android:textStyle="normal"
            android:textSize="14sp"
            android:textColor="@color/red1"
            android:text="(0) List"
            android:layout_gravity="left"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/transferProductList"
        tools:listitem="@layout/transfer_draft_list_item"
        android:layout_width="match_parent"
        android:paddingBottom="40dp"
        android:visibility="gone"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:layout_width="match_parent"
        android:gravity="center"
        android:visibility="gone"
        android:id="@+id/empty_text"
        android:textStyle="bold"
        android:text="No Record Found....!"
        android:layout_gravity="center"
        android:layout_height="match_parent"/>

</LinearLayout>