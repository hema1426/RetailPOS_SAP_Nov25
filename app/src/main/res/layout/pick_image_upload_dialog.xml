<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/_5sdp"
        android:background="@color/colorPrimary"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="5dp"
            android:text="Upload - "
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/invNo_txt_edit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="5dp"
            android:text=""
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold" />
        </LinearLayout>


        <ImageView
            android:id="@+id/close_btn_pickdel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_gravity="center"
            android:layout_marginRight="10dp"
            android:padding="6sp"
            android:src="@drawable/ic_baseline_close_24"
            app:tint="@color/white" />

    </RelativeLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="@dimen/_10sdp"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="match_parent"
            android:orientation="vertical"
            android:layout_marginRight="@dimen/_10sdp"
            android:id="@+id/signature_lay_sched"
            android:layout_weight="1"
            android:visibility="gone"
            android:layout_height="wrap_content">


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="5dp"
                android:id="@+id/signature_title"
                android:drawablePadding="10dp"
                android:drawableLeft="@drawable/ic_interface"
                android:text="Signature"
                android:textColor="#212121"
                android:layout_marginLeft="5dp"
                android:textSize="12sp"
                />

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:scaleType="fitXY"
                android:padding="2dp"
                android:id="@+id/signature_sched"
                android:gravity="center|left"
                android:layout_marginLeft="10dp"
                android:background="#f3f3f3" />

        </LinearLayout>

        <LinearLayout
        android:layout_width="match_parent"
        android:orientation="horizontal"
        android:id="@+id/attachement_layout_inv"
        android:layout_weight="1"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="10dp"
            android:padding="5dp"
            android:layout_gravity="center"
            android:textStyle="bold"
            android:textColor="@color/pink_clr"
            android:text="Attachment :"
            android:textSize="13sp"
            />

        <TextView
            android:layout_width="match_parent"
            android:padding="10dp"
            android:layout_margin="10dp"
            android:drawablePadding="10dp"
            android:text="Select Image"
            android:id="@+id/select_Img_pickdel"
            android:drawableLeft="@drawable/ic_baseline_camera_enhance_24"
            android:layout_height="40dp"
            android:background="#F3f3f3" />

    </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:orientation="vertical"
        android:layout_margin="10dp"
        android:id="@+id/signature_layout"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

        <TextView
            android:layout_width="wrap_content"
            android:text="Signature"
            android:layout_gravity="center"
            android:textStyle="bold"
            android:textColor="@color/pink_clr"
            android:textSize="14dp"
            android:layout_height="wrap_content"/>
        <ImageView
            android:id="@+id/addSignat_Img"
            android:layout_width="50dp"
            android:layout_height="40dp"
            android:layout_marginLeft="@dimen/_5sdp"
            android:layout_marginTop="5dp"
            android:padding="5dp"
            android:visibility="visible"
            android:layout_gravity="right"
            android:src="@drawable/ic_add_circle_outline"
            app:tint="@color/green_clr1" />
        </LinearLayout>
        <ImageView
            android:id="@+id/btnCloseSignature"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_baseline_close_24"
            android:padding="5dp"
            android:layout_alignParentRight="true"
            android:layout_margin="6dp"
            android:visibility="gone"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/red1" />
        </RelativeLayout>

        <ImageView
            android:layout_width="match_parent"
            android:background="#f4f4f4"
            android:id="@+id/signature_capture"
            android:layout_height="@dimen/_130sdp"/>

    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:visibility="gone"
        android:orientation="vertical"
        >
        <TextView
        android:layout_width="wrap_content"
        android:text="status"
        android:textColor="@color/pink_clr"
        android:textSize="14dp"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:focusableInTouchMode="true"
        android:orientation="vertical"
        android:layout_height="wrap_content">

        <Spinner
            android:id="@+id/spinner_status_pickD"
            android:layout_marginTop="10dp"
            android:layout_width="match_parent"
            android:background="@drawable/invoice_edit_text"
            android:layout_height="35dp"
            android:entries="@array/sales_arrays"
            android:prompt="@string/invoice_prompt" />
    </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/submit_img_inv"
        android:layout_width="100dp"
        android:layout_height="35dp"
        android:layout_marginRight="15dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="15dp"
        android:text="submit"
        android:background="@drawable/layout_border_orange_rad5_hash"
        android:gravity="center"
        android:textStyle="bold"
        android:layout_gravity="right"
        android:textColor="@color/white"
        android:textSize="15sp"
        />

</LinearLayout>